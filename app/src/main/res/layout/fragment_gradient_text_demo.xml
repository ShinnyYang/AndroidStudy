<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <org.ninetripods.mq.study.widget.GradientTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="横向渐变 / 单行"
            android:textSize="24sp"
            android:textStyle="bold"
            app:gradientCenterColor="#FFF4A261"
            app:gradientEndColor="#FFE76F51"
            app:gradientOrientation="horizontal"
            app:gradientStartColor="#FF2A9D8F" />

        <org.ninetripods.mq.study.widget.GradientTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="纵向渐变 / 单行"
            android:textSize="24sp"
            android:textStyle="bold"
            app:gradientCenterColor="#FF8ECAE6"
            app:gradientEndColor="#FF3A86FF"
            app:gradientOrientation="vertical"
            app:gradientStartColor="#FF8338EC" />

        <org.ninetripods.mq.study.widget.GradientTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:maxLines="3"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="横向渐变 / 多行&#10;用于较长标题或说明文案"
            android:textSize="20sp"
            android:textStyle="bold"
            app:gradientCenterColor="#FFFFC857"
            app:gradientEndColor="#FFFF5D8F"
            app:gradientOrientation="horizontal"
            app:gradientStartColor="#FF6A4C93" />

        <org.ninetripods.mq.study.widget.GradientTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:maxLines="3"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="纵向渐变 / 多行&#10;颜色沿文本高度变化"
            android:textSize="20sp"
            android:textStyle="bold"
            app:gradientCenterColor="#FFB8F2E6"
            app:gradientEndColor="#FF5E60CE"
            app:gradientOrientation="vertical"
            app:gradientStartColor="#FFFFD166" />

        <org.ninetripods.mq.study.widget.GradientTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="两色渐变 / 单行"
            android:textSize="22sp"
            android:textStyle="bold"
            app:gradientEndColor="#FF06D6A0"
            app:gradientOrientation="horizontal"
            app:gradientStartColor="#FF118AB2" />

    </LinearLayout>
</ScrollView>
