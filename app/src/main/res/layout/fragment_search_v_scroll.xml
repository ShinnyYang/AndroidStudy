<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- 方案一：ViewPager2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="方案一：ViewPager2 纵向轮播"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tech_viewpager2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="核心技术栈：MVPager2 + ViewPager2（ORIENTATION_VERTICAL）+ RecyclerView.Adapter + TextLoader + 自动轮播（setAutoPlay / setPageInterval）。适合可扩展 Banner、复杂 Item、手势联动。"
            android:textColor="@color/gray_holo_dark"
            android:textSize="13sp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/vp_tb_search_bar_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_white_oval"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_scan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:padding="2dp"
                android:src="@mipmap/iv_tb_search" />

            <TextView
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/gray_pure" />

            <org.ninetripods.lib_viewpager2.MVPager2
                android:id="@+id/mvp_pager2"
                android:layout_width="0dp"
                android:layout_height="@dimen/vp_tb_search_bar_height"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_search"
                style="@style/btn_style_tb_search"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:padding="1dp"
                android:text="搜索" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 方案二：ViewFlipper -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="方案二：ViewFlipper 上下轮播"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tech_viewflipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="核心技术栈：SearchHintMarqueeView（继承 ViewFlipper）+ Animation（translate + alpha）+ flipInterval 自动翻页 + 可见性生命周期启停。适合搜索 Hint 等轻量文案切换，实现更轻。"
            android:textColor="@color/gray_holo_dark"
            android:textSize="13sp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/vp_tb_search_bar_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_white_oval"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_scan_marquee"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:padding="2dp"
                android:src="@mipmap/iv_tb_search" />

            <TextView
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/gray_pure" />

            <org.ninetripods.mq.study.widget.SearchHintMarqueeView
                android:id="@+id/search_hint_marquee"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_search_marquee"
                style="@style/btn_style_tb_search"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:padding="1dp"
                android:text="搜索" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </LinearLayout>
</ScrollView>
